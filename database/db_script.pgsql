CREATE TABLE "syslog" (
  "last_exec" bigint NOT NULL,
  "numb_exec" bigint NOT NULL
);

CREATE TABLE "userlog" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "action" bool NOT NULL,
  "creation_date" bigint NOT NULL,
  "account_id" bigint NOT NULL
);

CREATE TABLE "notification" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "message" varchar(256) NOT NULL,
  "read" bool NOT NULL DEFAULT false,
  "creation_date" bigint NOT NULL,
  "account_id" bigint NOT NULL
);

CREATE TABLE "account" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "name" varchar(64) NOT NULL,
  "username" varchar(64) NOT NULL,
  "password" varchar(256) NOT NULL,
  "active" bool NOT NULL DEFAULT false,
  "email" varchar(128) NOT NULL,
  "type" varchar(32) NOT NULL
);

CREATE TABLE "client" (
  "account_id" integer UNIQUE NOT NULL,
  "nif" varchar(9) UNIQUE NOT NULL,
  "phone_number" varchar(9) NOT NULL,
  "residence" varchar(128) NOT NULL,
  "business_sector" varchar(64) NOT NULL,
  "tier" varchar(1) NOT NULL
);

CREATE TABLE "employee" (
  "account_id" integer UNIQUE NOT NULL,
  "nif" varchar(9) UNIQUE NOT NULL,
  "phone_number" varchar(9) NOT NULL,
  "residence" varchar(128) NOT NULL,
  "lvl_expertise" smallint NOT NULL,
  "start_date" bigint NOT NULL
);

CREATE TABLE "equipment" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "client_id" integer NOT NULL,
  "brand" varchar(64) NOT NULL,
  "model" varchar(64) NOT NULL,
  "sku" varchar(7) UNIQUE NOT NULL,
  "batch" varchar(16) NOT NULL,
  "manufacture_date" bigint NOT NULL,
  "submission_date" bigint NOT NULL,
  "repair_date" bigint NOT NULL
);

CREATE TABLE "repair" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "employee_id" integer NOT NULL,
  "equipment_id" integer NOT NULL,
  "repair_number" varchar(16) UNIQUE NOT NULL,
  "start_date" bigint NOT NULL,
  "end_date" bigint,
  "duration" bigint,
  "price" numeric(10,2),
  "state" varchar(32) NOT NULL,
  "notes" varchar(256)
);

CREATE TABLE "part_repair" (
  "repair_id" integer NOT NULL,
  "part_id" integer NOT NULL
);

CREATE TABLE "part" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "employee_id" integer NOT NULL,
  "repair_id" integer NOT NULL,
  "code" varchar(128) UNIQUE NOT NULL,
  "designation" varchar(128) NOT NULL,
  "manufacturer" varchar(128) NOT NULL,
  "amount" integer NOT NULL
);

CREATE TABLE "test" (
  "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY NOT NULL,
  "employee_id" integer NOT NULL,
  "repair_id" integer NOT NULL,
  "designation" varchar(128) NOT NULL,
  "description" varchar(256) NOT NULL,
  "test_date" bigint NOT NULL
);

ALTER TABLE "userlog" ADD FOREIGN KEY ("account_id") REFERENCES "account" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "notification" ADD FOREIGN KEY ("account_id") REFERENCES "account" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "client" ADD FOREIGN KEY ("account_id") REFERENCES "account" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "employee" ADD FOREIGN KEY ("account_id") REFERENCES "account" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "equipment" ADD FOREIGN KEY ("client_id") REFERENCES "client" ("account_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "repair" ADD FOREIGN KEY ("employee_id") REFERENCES "employee" ("account_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "repair" ADD FOREIGN KEY ("equipment_id") REFERENCES "equipment" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "part_repair" ADD FOREIGN KEY ("repair_id") REFERENCES "repair" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "part_repair" ADD FOREIGN KEY ("part_id") REFERENCES "part" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "part" ADD FOREIGN KEY ("employee_id") REFERENCES "employee" ("account_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "part" ADD FOREIGN KEY ("repair_id") REFERENCES "repair" ("id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "test" ADD FOREIGN KEY ("employee_id") REFERENCES "employee" ("account_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "test" ADD FOREIGN KEY ("repair_id") REFERENCES "repair" ("id") DEFERRABLE INITIALLY IMMEDIATE;
